APP_ORIGIN=http://localhost:3000

# Sign in with an existing vcglone account. Set the same secret in vcglone.
# Use a long random value (at least 32 bytes), never a password.
# VCGLONE_URL=http://localhost:3100
# SSO_ISSUER=http://localhost:3100
# SSO_CLIENT_ID=desk
# SSO_SHARED_SECRET=replace-with-the-same-secret-as-vcglone
# SSO_REDIRECT_URI=http://localhost:3000/api/v1/auth/sso/callback
# Used only by npm run db:admin.
# ADMIN_EMAIL=admin@example.com
# ADMIN_NAME=Administrator
# ADMIN_PASSWORD=your-unique-admin-password
EMAIL_WEBHOOK_SECRET=dev-webhook-secret

# Server-only. Prefer Supabase URI. Falls back to DATABASE_URL.
# Never put the database password in a NEXT_PUBLIC_ variable.
# SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require
# DATABASE_URL=postgres://desk:password@127.0.0.1:5432/desk

# Leave SMTP_HOST unset to print mail in the server log.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
# EMAIL_FROM=Desk <desk@vethancon.com>

# Leave these unset to store files in data/uploads.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
