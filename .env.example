SEED_PASSWORD=Desk-staff-1
EMAIL_WEBHOOK_SECRET=dev-webhook-secret

# Server-only. Prefer Supabase URI. Falls back to DATABASE_URL.
# Never put the database password in a NEXT_PUBLIC_ variable.
# SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require
# DATABASE_URL=postgres://desk:password@127.0.0.1:5432/desk

# Leave SMTP_HOST unset to print mail in the server log.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
# EMAIL_FROM=Desk <desk@vethancon.com>

# Leave these unset to store files in data/uploads.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
